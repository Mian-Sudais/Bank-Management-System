<Page
    x:Class="ModernUI.CustomerDashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">

    <Page.Resources>
        <SolidColorBrush x:Key="SidebarBg" Color="#0D1117" />
        <SolidColorBrush x:Key="AccentBlue" Color="#2F80ED" />
        <SolidColorBrush x:Key="TextPrimary" Color="#F0F6FC" />
        <SolidColorBrush x:Key="TextSecondary" Color="#8B949E" />
        <SolidColorBrush x:Key="ContentBg" Color="#F6F8FA" />
        <SolidColorBrush x:Key="CardBg" Color="#FFFFFF" />
        <SolidColorBrush x:Key="CardBorder" Color="#D0D7DE" />
        <SolidColorBrush x:Key="DividerColor" Color="#21262D" />
        <SolidColorBrush x:Key="StatusGreen" Color="#3FB950" />
        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#8B949E" />
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="FontFamily" Value="Segoe UI Variable Text" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="CharacterSpacing" Value="100" />
            <Setter Property="Margin" Value="12,16,0,4" />
        </Style>
    </Page.Resources>

    <Page.Transitions>
        <TransitionCollection>
            <EntranceThemeTransition />
        </TransitionCollection>
    </Page.Transitions>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" Background="{StaticResource SidebarBg}">
            <Border HorizontalAlignment="Right" Width="1" Opacity="0.3">
                <Border.Background>
                    <SolidColorBrush Color="#30363D" />
                </Border.Background>
            </Border>
            <StackPanel Margin="0,0,1,0">
                <Border Padding="16,24,16,20" BorderThickness="0,0,0,1" BorderBrush="{StaticResource DividerColor}">
                    <StackPanel>
                        <Border Width="48" Height="48" CornerRadius="24" HorizontalAlignment="Left" Margin="0,0,0,12">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#1D6BD4" Offset="0" />
                                    <GradientStop Color="#2F80ED" Offset="0.5" />
                                    <GradientStop Color="#56CCF2" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <TextBlock x:ConnectionId='18' x:Name="AvatarInitials" Text="--" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16" FontWeight="SemiBold" FontFamily="Segoe UI Variable Display" Foreground="White" />
                        </Border>
                        <TextBlock Text="Welcome back," FontSize="11" FontFamily="Segoe UI Variable Text" Foreground="{StaticResource TextSecondary}" />
                        <TextBlock x:ConnectionId='16' x:Name="CustomerNameText" Text="..." FontSize="15" FontWeight="SemiBold" FontFamily="Segoe UI Variable Display" Foreground="{StaticResource TextPrimary}" Margin="0,1,0,0" />
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Ellipse Width="7" Height="7" Fill="{StaticResource StatusGreen}" VerticalAlignment="Center" Margin="0,0,5,0" />
                            <TextBlock x:ConnectionId='17' x:Name="CustomerIdText" Text="ID: ---" FontSize="11" FontFamily="Segoe UI Variable Text" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <ScrollViewer VerticalScrollBarVisibility="Hidden" Padding="8,8,8,0">
                    <StackPanel>
                        <TextBlock Text="ACCOUNTS" Style="{StaticResource SectionLabel}" />
                        <Button x:ConnectionId='8' x:Name="OpenAccountBtn"                              Style="{StaticResource NavButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <FontIcon Glyph="&#xE8C7;" FontSize="15" Foreground="#8B949E" />
                                <TextBlock Text="Open Account" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button x:ConnectionId='9' x:Name="ShowBalanceBtn"                              Style="{StaticResource NavButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <FontIcon Glyph="&#xE8B7;" FontSize="15" Foreground="#8B949E" />
                                <TextBlock Text="Show Balance" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button x:ConnectionId='10' x:Name="TotalAccountsBtn"                                Style="{StaticResource NavButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <FontIcon Glyph="&#xE80A;" FontSize="15" Foreground="#8B949E" />
                                <TextBlock Text="Total Accounts" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <TextBlock Text="TRANSACTIONS" Style="{StaticResource SectionLabel}" />
                        <Button x:ConnectionId='11' x:Name="DepositBtn"                          Style="{StaticResource NavButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <FontIcon Glyph="&#xE8AB;" FontSize="15" Foreground="#3FB950" />
                                <TextBlock Text="Deposit" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button x:ConnectionId='12' x:Name="WithdrawBtn"                           Style="{StaticResource NavButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <FontIcon Glyph="&#xE74E;" FontSize="15" Foreground="#F85149" />
                                <TextBlock Text="Withdraw" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button x:ConnectionId='13' x:Name="TransferBtn"                           Style="{StaticResource NavButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <FontIcon Glyph="&#xE8AB;" FontSize="15" Foreground="#2F80ED" />
                                <TextBlock Text="Transfer" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button x:ConnectionId='14' x:Name="HistoryBtn"                          Style="{StaticResource NavButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <FontIcon Glyph="&#xE81C;" FontSize="15" Foreground="#8B949E" />
                                <TextBlock Text="Transactions" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <TextBlock Text="SERVICES" Style="{StaticResource SectionLabel}" />
                        <Button x:ConnectionId='15' x:Name="ApplyLoanBtn"                            Style="{StaticResource NavButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <FontIcon Glyph="&#xE8A1;" FontSize="15" Foreground="#D29922" />
                                <TextBlock Text="Apply for Loan" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </ScrollViewer>

                <Border Padding="8,8" BorderThickness="0,1,0,0" BorderBrush="{StaticResource DividerColor}" Margin="0,16,0,0">
                    <Button x:ConnectionId='7' x:Name="LogoutBtn"                         Style="{StaticResource DangerNavButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE7E8;" FontSize="15" Foreground="#F85149" />
                            <TextBlock Text="Sign Out" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </Border>
            </StackPanel>
        </Grid>

        <Grid Grid.Column="1" Background="{StaticResource ContentBg}">
            <Grid.RowDefinitions>
                <RowDefinition Height="56" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Border Grid.Row="0" Padding="24,0" BorderThickness="0,0,0,1">
                <Border.Background>
                    <SolidColorBrush Color="#FFFFFF" />
                </Border.Background>
                <Border.BorderBrush>
                    <SolidColorBrush Color="#D0D7DE" />
                </Border.BorderBrush>
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="6">
                        <TextBlock Text="Dashboard" FontSize="14" FontWeight="SemiBold" FontFamily="Segoe UI Variable Display" Foreground="#1F2328" />
                        <FontIcon Glyph="&#xE76C;" FontSize="10" Foreground="#8B949E" VerticalAlignment="Center" />
                        <TextBlock x:ConnectionId='6' x:Name="PageSubtitleText" Text="Overview" FontSize="13" FontFamily="Segoe UI Variable Text" Foreground="#8B949E" VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1" Padding="28,24">
                <StackPanel Spacing="0">
                    <Border x:ConnectionId='2' x:Name="WelcomeBanner" CornerRadius="12" Padding="24,20" Margin="0,0,0,24" BorderThickness="1" BorderBrush="#C8E6F5">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#EBF4FF" Offset="0" />
                                <GradientStop Color="#F0F7FF" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <Grid>
                            <StackPanel>
                                <TextBlock x:ConnectionId='5' x:Name="BannerGreetingText" Text="Welcome" FontSize="18" FontWeight="SemiBold" FontFamily="Segoe UI Variable Display" Foreground="#0D1117" />
                                <TextBlock Text="Here is a summary of your financial activity." FontSize="13" FontFamily="Segoe UI Variable Text" Foreground="#57606A" Margin="0,4,0,0" />
                            </StackPanel>
                            <Border HorizontalAlignment="Right" VerticalAlignment="Center" Padding="10,6" CornerRadius="6" Background="#2F80ED">
                                <TextBlock Text="Active Account" FontSize="11.5" FontWeight="SemiBold" FontFamily="Segoe UI Variable Text" Foreground="White" />
                            </Border>
                        </Grid>
                    </Border>

                    <Border x:ConnectionId='3' x:Name="ResultCard" CornerRadius="12" Padding="20" BorderThickness="1" BorderBrush="{StaticResource CardBorder}" Background="{StaticResource CardBg}" MinHeight="320">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,16" Spacing="8">
                                <Border Width="6" Height="6" CornerRadius="3" Background="#2F80ED" VerticalAlignment="Center" />
                                <TextBlock Text="OUTPUT" FontSize="11" FontWeight="SemiBold" FontFamily="Segoe UI Variable Text" Foreground="#57606A" VerticalAlignment="Center" CharacterSpacing="80" />
                            </StackPanel>
                            <Border Height="1" Background="#D0D7DE" Margin="0,0,0,16" Opacity="0.5" />
                            <TextBlock x:ConnectionId='4' x:Name="ResultText" TextWrapping="Wrap" FontFamily="Cascadia Code, Consolas, Courier New" FontSize="13" LineHeight="22" Foreground="#1F2328" IsTextSelectionEnabled="True" Text="Select an action from the sidebar to get started." />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>

