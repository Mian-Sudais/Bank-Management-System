<Page
    x:Class="ModernUI.LoginPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">

    <!-- ════════════════════════════════════════════════════════════════
         ENTRANCE TRANSITION — Slide up + fade in from Page root
         ════════════════════════════════════════════════════════════════ -->
    <Page.Transitions>
        <TransitionCollection>
            <EntranceThemeTransition IsStaggeringEnabled="True" FromVerticalOffset="40"/>
        </TransitionCollection>
    </Page.Transitions>

    <!-- ════════════════════════════════════════════════════════════════
         ROOT GRID — Layered: animated mesh background + card
         ════════════════════════════════════════════════════════════════ -->
    <Grid>

        <!-- Layer 0: Radial ambient glow meshes -->
        <Canvas IsHitTestVisible="False">
            <!-- Top-left aurora blob -->
            <Ellipse Canvas.Left="-120" Canvas.Top="-80"
                     Width="500" Height="400"
                     Opacity="0.06">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#3B82F6" Offset="0"/>
                        <GradientStop Color="Transparent" Offset="1"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
            <!-- Bottom-right violet blob — positioned with Left/Top from right edge estimate -->
            <Ellipse Canvas.Left="700" Canvas.Top="400"
                     Width="600" Height="500"
                     Opacity="0.05">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#8B5CF6" Offset="0"/>
                        <GradientStop Color="Transparent" Offset="1"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
            <!-- Center cyan accent — fixed pixel coords (≈ center of 1200×800 window) -->
            <Ellipse Canvas.Left="450" Canvas.Top="220"
                     Width="300" Height="300"
                     Opacity="0.04">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#06B6D4" Offset="0"/>
                        <GradientStop Color="Transparent" Offset="1"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
        </Canvas>

        <!-- Layer 1: Subtle dot-grid texture overlay -->
        <Rectangle IsHitTestVisible="False" Opacity="0.018">
            <Rectangle.Fill>
                <ImageBrush Stretch="UniformToFill" Opacity="1"/>
            </Rectangle.Fill>
        </Rectangle>

        <!-- Layer 2: Scrollable card area -->
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="24">

            <Grid HorizontalAlignment="Center"
                  VerticalAlignment="Top"
                  MinHeight="100">

                <!-- ════════════════════════════════════════════════════
                     GLASS CARD — 2030 Obsidian glass morphism
                     ════════════════════════════════════════════════════ -->
                <Border x:ConnectionId='2' x:Name="MainCard"
        Width="460"
        CornerRadius="20"
        BorderThickness="1"
        Margin="0,36">

                    <Border.BorderBrush>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#1E2D4A" Offset="0"/>
                            <GradientStop Color="#0D1828" Offset="0.5"/>
                            <GradientStop Color="#1E2D4A" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.BorderBrush>

                    <!-- Card background — deep glass -->
                    <Border.Background>
                        <SolidColorBrush Color="#111827" Opacity="0.75"/>
                    </Border.Background>

                    <Grid>
                        <!-- Card inner top-edge shimmer line -->
                        <Border CornerRadius="20,20,0,0"
                                Height="1"
                                VerticalAlignment="Top"
                                Opacity="0.25">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="Transparent" Offset="0"/>
                                    <GradientStop Color="#3B82F6" Offset="0.35"/>
                                    <GradientStop Color="#06B6D4" Offset="0.65"/>
                                    <GradientStop Color="Transparent" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>

                        <!-- Main content -->
                        <StackPanel Spacing="0" Padding="36,32">

                            <!-- ── Logo / Brand Block ──────────────────────── -->
                            <StackPanel HorizontalAlignment="Center"
                                        Spacing="12"
                                        Margin="0,0,0,28">

                                <!-- Icon container with glow ring -->
                                <Grid HorizontalAlignment="Center" Width="68" Height="68">
                                    <!-- Outer glow ring -->
                                    <Ellipse Width="68" Height="68" Opacity="0.15">
                                        <Ellipse.Fill>
                                            <RadialGradientBrush>
                                                <GradientStop Color="#3B82F6" Offset="0.6"/>
                                                <GradientStop Color="Transparent" Offset="1"/>
                                            </RadialGradientBrush>
                                        </Ellipse.Fill>
                                    </Ellipse>
                                    <!-- Icon border ring -->
                                    <Border Width="56" Height="56"
                                            CornerRadius="16"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            BorderThickness="1">
                                        <Border.BorderBrush>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                <GradientStop Color="#3B82F6" Offset="0"/>
                                                <GradientStop Color="#06B6D4" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Border.BorderBrush>
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                <GradientStop Color="#1D4ED8" Offset="0"/>
                                                <GradientStop Color="#0E7490" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                        <FontIcon Glyph="&#xE8F7;"
                                                  FontSize="24"
                                                  Foreground="White"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                                    </Border>
                                </Grid>

                                <TextBlock Text="Bank Management"
                                           FontSize="24"
                                           FontWeight="SemiBold"
                                           FontFamily="Segoe UI Variable Display"
                                           Foreground="{StaticResource TextPrimary}"
                                           HorizontalAlignment="Center"/>

                                <TextBlock Text="Secure access to your financial dashboard"
                                           FontSize="13"
                                           FontFamily="Segoe UI Variable Text"
                                           Foreground="{StaticResource TextSecondary}"
                                           HorizontalAlignment="Center"
                                           TextWrapping="Wrap"
                                           TextAlignment="Center"/>
                            </StackPanel>

                            <!-- ── Divider ─────────────────────────────────── -->
                            <Border Height="1" Margin="0,0,0,24" Opacity="0.35">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="Transparent" Offset="0"/>
                                        <GradientStop Color="#1E2D4A" Offset="0.3"/>
                                        <GradientStop Color="#1E2D4A" Offset="0.7"/>
                                        <GradientStop Color="Transparent" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>

                            <!-- ── Login Form ──────────────────────────────── -->
                            <StackPanel Spacing="0">

                                <!-- Login Type label -->
                                <TextBlock Text="LOGIN TYPE"
                                           FontSize="10"
                                           FontWeight="SemiBold"
                                           FontFamily="Segoe UI Variable Text"
                                           Foreground="#9CA3AF"
                                           CharacterSpacing="100"
                                           Margin="2,0,0,6"/>

                                <ComboBox x:ConnectionId='4' x:Name="RoleCombo"
                                          SelectedIndex="0"
                                          Style="{StaticResource StyledComboBox}"
                                          HorizontalAlignment="Stretch">
                                    <ComboBoxItem Content="Customer"/>
                                    <ComboBoxItem Content="Admin"/>
                                </ComboBox>

                                <!-- ID label -->
                                <TextBlock Text="ID"
                                           FontSize="10"
                                           FontWeight="SemiBold"
                                           FontFamily="Segoe UI Variable Text"
                                           Foreground="#9CA3AF"
                                           CharacterSpacing="100"
                                           Margin="2,20,0,6"/>

                                <TextBox x:ConnectionId='5' x:Name="IdBox"
                                         PlaceholderText="Customer ID or EMP001"
                                         Style="{StaticResource StyledTextBox}"/>

                                <!-- Password label -->
                                <TextBlock Text="PASSWORD"
                                           FontSize="10"
                                           FontWeight="SemiBold"
                                           FontFamily="Segoe UI Variable Text"
                                           Foreground="#9CA3AF"
                                           CharacterSpacing="100"
                                           Margin="2,20,0,6"/>

                                <PasswordBox x:ConnectionId='6' x:Name="PassBox"
                                             PlaceholderText="Enter your password"
                                             Style="{StaticResource StyledPasswordBox}"/>

                                <!-- Sign In Button -->
                                <Button x:ConnectionId='7' x:Name="LoginBtn"
                                        Content="Sign In"
                                                              
                                        Style="{StaticResource PremiumButtonStyle}"
                                        Margin="0,24,0,0"/>

                                <!-- Links row -->
                                <StackPanel HorizontalAlignment="Center"
                                            Spacing="6"
                                            Margin="0,20,0,0">
                                    <TextBlock HorizontalAlignment="Center" FontSize="13">
                                        <Run Text="Don't have an account?  "
                                             Foreground="{StaticResource TextSecondary}"/>
                                        <Hyperlink x:ConnectionId='9'                         >
                                            <Run Text="Sign Up"
                                                 Foreground="#3B82F6"
                                                 FontFamily="Segoe UI Variable Text"
                                                 FontWeight="SemiBold"/>
                                        </Hyperlink>
                                    </TextBlock>
                                    <TextBlock HorizontalAlignment="Center" FontSize="13">
                                        <Hyperlink x:ConnectionId='8'                         >
                                            <Run Text="Forgot Password?"
                                                 Foreground="#3B82F6"
                                                 FontFamily="Segoe UI Variable Text"
                                                 FontWeight="SemiBold"/>
                                        </Hyperlink>
                                    </TextBlock>
                                </StackPanel>
                            </StackPanel>

                            <!-- ── Error InfoBar ───────────────────────────── -->
                            <InfoBar x:ConnectionId='3' x:Name="ErrorBar"
                                     Severity="Error"
                                     IsOpen="False"
                                     IsClosable="True"
                                     Margin="0,20,0,0"
                                     FontFamily="Segoe UI Variable Text"
                                     CornerRadius="9"/>

                        </StackPanel>
                    </Grid>
                </Border>
                <TextBlock HorizontalAlignment="Center"
               VerticalAlignment="Bottom"
               FontSize="11"
               FontFamily="Segoe UI Variable Text"
               Foreground="#6B7280"
               Margin="0,30,0,0">
               Developer: <Run Text="Sudais Ali Shah" FontWeight="SemiBold" Foreground="#9CA3AF"/>
                </TextBlock>

            </Grid>
        </ScrollViewer>
    </Grid>
</Page>

