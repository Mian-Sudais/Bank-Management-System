<Page
    x:Class="ModernUI.AdminDashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">

    <Page.Transitions>
        <TransitionCollection>
            <EntranceThemeTransition IsStaggeringEnabled="True"/>
        </TransitionCollection>
    </Page.Transitions>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ════════════════════════════════════════════════════════════
             SIDEBAR
             ════════════════════════════════════════════════════════════ -->
        <Grid Grid.Column="0" Background="#080C14">

            <Border HorizontalAlignment="Right" Width="1" Opacity="0.4">
                <Border.Background>
                    <SolidColorBrush Color="#1E2D4A"/>
                </Border.Background>
            </Border>

            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="0,0,1,0">

                    <!-- Admin profile block -->
                    <Border Padding="16,24,16,20"
                            BorderThickness="0,0,0,1"
                            BorderBrush="{StaticResource DividerColor}">
                        <StackPanel>
                            <Border Width="48" Height="48" CornerRadius="24"
                                    HorizontalAlignment="Left" Margin="0,0,0,12">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#1D4ED8" Offset="0"/>
                                        <GradientStop Color="#3B82F6" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <FontIcon Glyph="&#xE7EF;" FontSize="20"
                                          Foreground="White"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                            </Border>

                            <TextBlock Text="Administrator"
                                       FontSize="11"
                                       FontFamily="Segoe UI Variable Text"
                                       Foreground="#9CA3AF"/>
                            <TextBlock Text="Admin Panel"
                                       FontSize="15" FontWeight="SemiBold"
                                       FontFamily="Segoe UI Variable Display"
                                       Foreground="#F1F5FF"
                                       Margin="0,2,0,0"/>
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <Ellipse Width="7" Height="7"
                                         Fill="#10D986"
                                         VerticalAlignment="Center"
                                         Margin="0,0,6,0"/>
                                <TextBlock Text="System Online"
                                           FontSize="11"
                                           FontFamily="Segoe UI Variable Text"
                                           Foreground="#9CA3AF"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Nav items -->
                    <StackPanel Padding="8,12,8,0">

                        <TextBlock Text="CUSTOMER MANAGEMENT"
                                   FontSize="10" FontWeight="SemiBold"
                                   FontFamily="Segoe UI Variable Text"
                                   Foreground="#6B7280"
                                   CharacterSpacing="120"
                                   Margin="14,20,0,6"/>

                        <Button x:ConnectionId='18' x:Name="ViewAllBtn"                         
                                Style="{StaticResource NavButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <FontIcon Glyph="&#xE8F0;" FontSize="15" Foreground="#9CA3AF"/>
                                <TextBlock Text="All Customers" VerticalAlignment="Center" Foreground="#E5E7EB"/>
                            </StackPanel>
                        </Button>

                        <Button x:ConnectionId='19' x:Name="SearchBtn"                        
                                Style="{StaticResource NavButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <FontIcon Glyph="&#xE721;" FontSize="15" Foreground="#9CA3AF"/>
                                <TextBlock Text="Search Customer" VerticalAlignment="Center" Foreground="#E5E7EB"/>
                            </StackPanel>
                        </Button>

                        <Border Height="1" Margin="16,8" Opacity="0.4">
                            <Border.Background>
                                <SolidColorBrush Color="#1E2D4A"/>
                            </Border.Background>
                        </Border>

                        <TextBlock Text="ACCOUNT CONTROLS"
                                   FontSize="10" FontWeight="SemiBold"
                                   FontFamily="Segoe UI Variable Text"
                                   Foreground="#6B7280"
                                   CharacterSpacing="120"
                                   Margin="14,20,0,6"/>

                        <Button x:ConnectionId='20' x:Name="FreezeBtn"                        
                                Style="{StaticResource NavButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <FontIcon Glyph="&#xE7B8;" FontSize="15" Foreground="#F59E0B"/>
                                <TextBlock Text="Freeze Account" VerticalAlignment="Center" Foreground="#E5E7EB"/>
                            </StackPanel>
                        </Button>

                        <Button x:ConnectionId='21' x:Name="UnfreezeBtn"                          
                                Style="{StaticResource NavButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <FontIcon Glyph="&#xE74A;" FontSize="15" Foreground="#10D986"/>
                                <TextBlock Text="Unfreeze Account" VerticalAlignment="Center" Foreground="#E5E7EB"/>
                            </StackPanel>
                        </Button>

                        <Border Height="1" Margin="16,8" Opacity="0.4">
                            <Border.Background>
                                <SolidColorBrush Color="#1E2D4A"/>
                            </Border.Background>
                        </Border>

                        <TextBlock Text="LOAN MANAGEMENT"
                                   FontSize="10" FontWeight="SemiBold"
                                   FontFamily="Segoe UI Variable Text"
                                   Foreground="#6B7280"
                                   CharacterSpacing="120"
                                   Margin="14,20,0,6"/>

                        <Button x:ConnectionId='22' x:Name="ApproveLoanBtn"                             
                                Style="{StaticResource NavButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <FontIcon Glyph="&#xE8A1;" FontSize="15" Foreground="#3B82F6"/>
                                <TextBlock Text="Approve Loan" VerticalAlignment="Center" Foreground="#E5E7EB"/>
                            </StackPanel>
                        </Button>

                    </StackPanel>

                    <!-- Sign Out -->
                    <Border Padding="8,12" BorderThickness="0,1,0,0"
                            BorderBrush="{StaticResource DividerColor}" Margin="0,8,0,0">
                        <Button x:ConnectionId='17' x:Name="LogoutBtn"                        
                                Style="{StaticResource DangerNavButtonStyle}"
                                HorizontalAlignment="Stretch">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <FontIcon Glyph="&#xE7E8;" FontSize="15" Foreground="#F43F5E"/>
                                <TextBlock Text="Sign Out" VerticalAlignment="Center"
                                           FontWeight="SemiBold" Foreground="#F43F5E"/>
                            </StackPanel>
                        </Button>
                    </Border>

                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- ════════════════════════════════════════════════════════════
             MAIN CONTENT
             ════════════════════════════════════════════════════════════ -->
        <Grid Grid.Column="1" Background="Transparent">
            <Grid.RowDefinitions>
                <RowDefinition Height="56"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Top bar -->
            <Border Grid.Row="0" Padding="24,0"
                    BorderThickness="0,0,0,1" BorderBrush="#1E2D4A">
                <Border.Background>
                    <SolidColorBrush Color="#0D1120" Opacity="0.6"/>
                </Border.Background>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="6">
                    <TextBlock Text="Admin Dashboard"
                               FontSize="14" FontWeight="SemiBold"
                               FontFamily="Segoe UI Variable Display"
                               Foreground="#F1F5FF"/>
                    <FontIcon Glyph="&#xE76C;" FontSize="10"
                              Foreground="#6B7280" VerticalAlignment="Center"/>
                    <TextBlock x:ConnectionId='16' x:Name="PageSubtitleText"
                               Text="Overview"
                               FontSize="13"
                               FontFamily="Segoe UI Variable Text"
                               Foreground="#9CA3AF"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- Search bar row -->
            <Border Grid.Row="1" Padding="24,14,24,12"
                    BorderThickness="0,0,0,1" BorderBrush="#1E2D4A">
                <Border.Background>
                    <SolidColorBrush Color="#0D1120" Opacity="0.6"/>
                </Border.Background>
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <TextBox x:ConnectionId='13' x:Name="SearchBox"
                             PlaceholderText="Search by name or CNIC…"
                             Width="320"
                             Style="{StaticResource StyledTextBox}"
                                                        />
                    <Button x:ConnectionId='14' Content="Search"
                                                   
                            Style="{StaticResource SearchActionButtonStyle}"/>
                    <Button x:ConnectionId='15' Content="Clear"
                                                  
                            Style="{StaticResource ActionButtonStyle}"/>
                </StackPanel>
            </Border>

            <!-- Output area -->
            <ScrollViewer Grid.Row="2" Padding="28,24">
                <StackPanel Spacing="16">

                    <!-- Result Card -->
                    <Border x:ConnectionId='2' x:Name="ResultCard"
                            CornerRadius="14"
                            Padding="0"
                            BorderThickness="1"
                            MinHeight="400">
                        <Border.BorderBrush>
                            <SolidColorBrush Color="#1E2D4A"/>
                        </Border.BorderBrush>
                        <Border.Background>
                            <SolidColorBrush Color="#0D1525" Opacity="0.5"/>
                        </Border.Background>

                        <StackPanel>
                            <!-- Card header -->
                            <Border Padding="20,16" BorderThickness="0,0,0,1" BorderBrush="#1E2D4A">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Border Width="6" Height="6" CornerRadius="3"
                                            Background="#3B82F6" VerticalAlignment="Center"/>
                                    <TextBlock x:ConnectionId='10' x:Name="TableTitleText"
                                               Text="OUTPUT"
                                               FontSize="10" FontWeight="SemiBold"
                                               FontFamily="Segoe UI Variable Text"
                                               Foreground="#6B7280"
                                               VerticalAlignment="Center"
                                               CharacterSpacing="120"/>
                                    <Border x:ConnectionId='11' x:Name="RowCountBadge"
                                            CornerRadius="8" Padding="8,2"
                                            Margin="4,0,0,0"
                                            Visibility="Collapsed">
                                        <Border.Background>
                                            <SolidColorBrush Color="#1E2D4A"/>
                                        </Border.Background>
                                        <TextBlock x:ConnectionId='12' x:Name="RowCountText"
                                                   FontSize="10"
                                                   FontFamily="Segoe UI Variable Text"
                                                   Foreground="#6B7280"/>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- Empty / plain-text state (shown for non-table output) -->
                            <Border x:ConnectionId='3' x:Name="PlainTextPanel" Padding="24,20">
                                <TextBlock x:ConnectionId='9' x:Name="ResultText"
                                           TextWrapping="Wrap"
                                           FontFamily="Cascadia Code, Consolas, Courier New"
                                           FontSize="13"
                                           LineHeight="22"
                                           Foreground="#F1F5FF"
                                           IsTextSelectionEnabled="True"
                                           Text="Select an action from the sidebar to begin administrative tasks."/>
                            </Border>

                            <!-- ══ TABLE PANEL ══ -->
                            <Border x:ConnectionId='4' x:Name="TablePanel" Visibility="Collapsed" Padding="0,0,0,8">
                                <StackPanel>

                                    <!-- Table header row -->
                                    <Border x:ConnectionId='5' x:Name="TableHeader"
                                            Padding="0,10"
                                            BorderThickness="0,0,0,1"
                                            BorderBrush="#1E2D4A">
                                        <Border.Background>
                                            <SolidColorBrush Color="#060B14"/>
                                        </Border.Background>
                                        <!-- Columns are injected in code-behind -->
                                        <Grid x:ConnectionId='8' x:Name="HeaderGrid" Margin="20,0"/>
                                    </Border>

                                    <!-- Table body rows -->
                                    <ItemsControl x:ConnectionId='6' x:Name="TableRows">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <!-- Each row is a Grid injected via code-behind wrapper -->
                                                <ContentPresenter Content="{Binding}"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                </StackPanel>
                            </Border>

                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>

