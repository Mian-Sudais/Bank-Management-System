<Page
    x:Class="ModernUI.ForgotPasswordPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">

    <Page.Transitions>
        <TransitionCollection>
            <EntranceThemeTransition IsStaggeringEnabled="True" FromVerticalOffset="40"/>
        </TransitionCollection>
    </Page.Transitions>

    <Grid>

        <!-- Layer 0: Ambient glow meshes -->
        <Canvas IsHitTestVisible="False">
            <Ellipse Canvas.Left="-120" Canvas.Top="-80"
                     Width="500" Height="400" Opacity="0.06">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#3B82F6" Offset="0"/>
                        <GradientStop Color="Transparent" Offset="1"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
            <Ellipse Canvas.Left="700" Canvas.Top="400"
                     Width="600" Height="500" Opacity="0.05">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#8B5CF6" Offset="0"/>
                        <GradientStop Color="Transparent" Offset="1"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
            <Ellipse Canvas.Left="450" Canvas.Top="220"
                     Width="300" Height="300" Opacity="0.04">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#06B6D4" Offset="0"/>
                        <GradientStop Color="Transparent" Offset="1"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
        </Canvas>

        <!-- Layer 1: Scrollable card area -->
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="24">

            <Grid HorizontalAlignment="Center" VerticalAlignment="Top" MinHeight="100">

                <Border x:ConnectionId='2' x:Name="MainCard"
                        Width="460"
                        CornerRadius="20"
                        BorderThickness="1"
                        Margin="0,36">

                    <Border.BorderBrush>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#1E2D4A" Offset="0"/>
                            <GradientStop Color="#0D1828" Offset="0.5"/>
                            <GradientStop Color="#1E2D4A" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.BorderBrush>

                    <Border.Background>
                        <SolidColorBrush Color="#111827" Opacity="0.75"/>
                    </Border.Background>

                    <Grid>
                        <!-- Card top-edge shimmer -->
                        <Border CornerRadius="20,20,0,0" Height="1"
                                VerticalAlignment="Top" Opacity="0.25">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="Transparent" Offset="0"/>
                                    <GradientStop Color="#3B82F6" Offset="0.35"/>
                                    <GradientStop Color="#06B6D4" Offset="0.65"/>
                                    <GradientStop Color="Transparent" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>

                        <StackPanel Spacing="0" Padding="36,32">

                            <!-- Header -->
                            <StackPanel HorizontalAlignment="Center" Spacing="12" Margin="0,0,0,28">
                                <Grid HorizontalAlignment="Center" Width="68" Height="68">
                                    <Ellipse Width="68" Height="68" Opacity="0.15">
                                        <Ellipse.Fill>
                                            <RadialGradientBrush>
                                                <GradientStop Color="#3B82F6" Offset="0.6"/>
                                                <GradientStop Color="Transparent" Offset="1"/>
                                            </RadialGradientBrush>
                                        </Ellipse.Fill>
                                    </Ellipse>
                                    <Border Width="56" Height="56"
                                            CornerRadius="16"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            BorderThickness="1">
                                        <Border.BorderBrush>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                <GradientStop Color="#3B82F6" Offset="0"/>
                                                <GradientStop Color="#06B6D4" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Border.BorderBrush>
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                <GradientStop Color="#1D4ED8" Offset="0"/>
                                                <GradientStop Color="#0E7490" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                        <FontIcon Glyph="&#xE72C;"
                                                  FontSize="24"
                                                  Foreground="White"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                                    </Border>
                                </Grid>

                                <TextBlock Text="Reset Password"
                                           FontSize="24"
                                           FontWeight="SemiBold"
                                           FontFamily="Segoe UI Variable Display"
                                           Foreground="{StaticResource TextPrimary}"
                                           HorizontalAlignment="Center"/>

                                <TextBlock Text="Verify your identity to create a new password"
                                           FontSize="13"
                                           FontFamily="Segoe UI Variable Text"
                                           Foreground="{StaticResource TextSecondary}"
                                           HorizontalAlignment="Center"
                                           TextWrapping="Wrap"
                                           TextAlignment="Center"/>
                            </StackPanel>

                            <!-- Divider -->
                            <Border Height="1" Margin="0,0,0,24" Opacity="0.35">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="Transparent" Offset="0"/>
                                        <GradientStop Color="#1E2D4A" Offset="0.3"/>
                                        <GradientStop Color="#1E2D4A" Offset="0.7"/>
                                        <GradientStop Color="Transparent" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>

                            <!-- Form -->
                            <StackPanel Spacing="0">

                                <TextBlock Text="CUSTOMER ID"
                                           FontSize="10" FontWeight="SemiBold"
                                           FontFamily="Segoe UI Variable Text"
                                           Foreground="#9CA3AF"
                                           CharacterSpacing="100"
                                           Margin="2,0,0,6"/>
                                <TextBox x:ConnectionId='4' x:Name="IdBox"
                                         PlaceholderText="e.g. CUST101"
                                         Style="{StaticResource StyledTextBox}"/>

                                <TextBlock Text="CNIC"
                                           FontSize="10" FontWeight="SemiBold"
                                           FontFamily="Segoe UI Variable Text"
                                           Foreground="#9CA3AF"
                                           CharacterSpacing="100"
                                           Margin="2,20,0,6"/>
                                <TextBox x:ConnectionId='5' x:Name="CnicBox"
                                         PlaceholderText="12345-1234567-8"
                                         Style="{StaticResource StyledTextBox}"
                                         InputScope="Number"/>

                                <TextBlock Text="BACKUP CODE"
                                           FontSize="10" FontWeight="SemiBold"
                                           FontFamily="Segoe UI Variable Text"
                                           Foreground="#9CA3AF"
                                           CharacterSpacing="100"
                                           Margin="2,20,0,6"/>
                                <TextBox x:ConnectionId='6' x:Name="BackupBox"
                                         PlaceholderText="6-digit code from sign-up"
                                         MaxLength="6"
                                         Style="{StaticResource StyledTextBox}"
                                         InputScope="Number"/>

                                <TextBlock Text="NEW PASSWORD"
                                           FontSize="10" FontWeight="SemiBold"
                                           FontFamily="Segoe UI Variable Text"
                                           Foreground="#9CA3AF"
                                           CharacterSpacing="100"
                                           Margin="2,20,0,6"/>
                                <PasswordBox x:ConnectionId='7' x:Name="NewPassBox"
                                             PlaceholderText="Minimum 8 characters"
                                             Style="{StaticResource StyledPasswordBox}"/>

                                <Button x:ConnectionId='8' x:Name="ResetBtn"
                                        Content="Reset Password"
                                                              
                                        Style="{StaticResource PremiumButtonStyle}"
                                        Margin="0,24,0,0"/>

                                <TextBlock HorizontalAlignment="Center"
                                           FontSize="13" Margin="0,20,0,0">
                                    <Hyperlink x:ConnectionId='9'                       >
                                        <Run Text="← Back to Sign In"
                                             Foreground="#3B82F6"
                                             FontFamily="Segoe UI Variable Text"
                                             FontWeight="SemiBold"/>
                                    </Hyperlink>
                                </TextBlock>
                            </StackPanel>

                            <!-- Feedback InfoBar -->
                            <InfoBar x:ConnectionId='3' x:Name="FeedbackBar"
                                     IsOpen="False"
                                     IsClosable="True"
                                     Margin="0,20,0,0"
                                     FontFamily="Segoe UI Variable Text"
                                     CornerRadius="9"
                                     RequestedTheme="Dark"/>

                        </StackPanel>
                    </Grid>
                </Border>
                <TextBlock HorizontalAlignment="Center"
               VerticalAlignment="Bottom"
               FontSize="11"
               FontFamily="Segoe UI Variable Text"
               Foreground="#6B7280"
               Margin="0,30,0,0">
               Developer: <Run Text="Sudais Ali Shah" FontWeight="SemiBold" Foreground="#9CA3AF"/>
                </TextBlock>
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>

