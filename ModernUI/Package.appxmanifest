<?xml version="1.0" encoding="utf-8"?>
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:mp="http://schemas.microsoft.com/appx/2014/phone/manifest"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap rescap mp">

	<Identity
	  Name="65d33863-ee3f-4d3d-89db-1599209e9f7d"
	  Publisher="CN=mians"
	  Version="1.0.0.0" />

	<mp:PhoneIdentity
	  PhoneProductId="65d33863-ee3f-4d3d-89db-1599209e9f7d"
	  PhonePublisherId="00000000-0000-0000-0000-000000000000"/>

	<Properties>
		<DisplayName>Bank Management System</DisplayName>
		<PublisherDisplayName>mians</PublisherDisplayName>
		<Logo>Assets\StoreLogo.png</Logo>
	</Properties>

	<Dependencies>
		<TargetDeviceFamily Name="Windows.Universal" MinVersion="10.0.17763.0" MaxVersionTested="10.0.26226.0" />
		<TargetDeviceFamily Name="Windows.Desktop"   MinVersion="10.0.17763.0" MaxVersionTested="10.0.26226.0" />
	</Dependencies>

	<Resources>
		<Resource Language="x-generate"/>
	</Resources>

	<Applications>
		<Application
		  Id="App"
		  Executable="$targetnametoken$.exe"
		  EntryPoint="$targetentrypoint$">
			<uap:VisualElements
			  DisplayName="Bank Management System"
			  Description="Secure banking management solution"
			  BackgroundColor="#060810"
			  Square150x150Logo="Assets\Square150x150Logo.png"
			  Square44x44Logo="Assets\Square44x44Logo.png">
				<uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" />
				<uap:SplashScreen Image="Assets\SplashScreen.png" />
			</uap:VisualElements>
		</Application>
	</Applications>

	<!--
    FIX: The warning was caused by placing rescap:Capability directly inside
    <Capabilities> without a <rescap:Capability> wrapper that the manifest
    validator recognises. The correct form is exactly as below — the rescap
    namespace prefix on the Capability element is what satisfies the schema.
    No duplicate <Applications> block (that was the original bug from v1).
  -->
	<Capabilities>
		<rescap:Capability Name="runFullTrust" />
	</Capabilities>

</Package>
