<Page
    x:Class="ModernUI.CustomerDashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">

    <Page.Transitions>
        <TransitionCollection>
            <EntranceThemeTransition/>
        </TransitionCollection>
    </Page.Transitions>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ════════════════════════════════════════════════════════════
             SIDEBAR
             ════════════════════════════════════════════════════════════ -->
        <Grid Grid.Column="0" Background="#080C14">

            <Border HorizontalAlignment="Right" Width="1" Opacity="0.4">
                <Border.Background>
                    <SolidColorBrush Color="#1E2D4A"/>
                </Border.Background>
            </Border>

            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="0,0,1,0">

                    <!-- Profile block -->
                    <Border Padding="16,24,16,20"
                            BorderThickness="0,0,0,1"
                            BorderBrush="{StaticResource DividerColor}">
                        <StackPanel>
                            <Border Width="48" Height="48" CornerRadius="24"
                                    HorizontalAlignment="Left" Margin="0,0,0,12">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#1D4ED8" Offset="0"/>
                                        <GradientStop Color="#3B82F6" Offset="0.5"/>
                                        <GradientStop Color="#06B6D4" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <TextBlock x:Name="AvatarInitials"
                                           Text="--"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           FontSize="16" FontWeight="SemiBold"
                                           FontFamily="Segoe UI Variable Display"
                                           Foreground="White"/>
                            </Border>

                            <TextBlock Text="Welcome back,"
                                       FontSize="11"
                                       FontFamily="Segoe UI Variable Text"
                                       Foreground="#9CA3AF"/>

                            <TextBlock x:Name="CustomerNameText"
                                       Text="..."
                                       FontSize="15" FontWeight="SemiBold"
                                       FontFamily="Segoe UI Variable Display"
                                       Foreground="#F1F5FF"
                                       Margin="0,2,0,0"/>

                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <Ellipse Width="7" Height="7"
                                         Fill="#10D986"
                                         VerticalAlignment="Center"
                                         Margin="0,0,6,0"/>
                                <TextBlock x:Name="CustomerIdText"
                                           Text="ID: ---"
                                           FontSize="11"
                                           FontFamily="Segoe UI Variable Text"
                                           Foreground="#9CA3AF"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Nav items -->
                    <StackPanel Padding="8,8,8,0">

                        <TextBlock Text="ACCOUNTS"
                                   FontSize="10" FontWeight="SemiBold"
                                   FontFamily="Segoe UI Variable Text"
                                   Foreground="#6B7280"
                                   CharacterSpacing="120"
                                   Margin="14,20,0,6"/>

                        <Button x:Name="OpenAccountBtn" Click="OpenAccountBtn_Click"
                                Style="{StaticResource NavButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <FontIcon Glyph="&#xE8C7;" FontSize="15" Foreground="#9CA3AF"/>
                                <TextBlock Text="Open Account" VerticalAlignment="Center" Foreground="#E5E7EB"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="ShowBalanceBtn" Click="ShowBalanceBtn_Click"
                                Style="{StaticResource NavButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <FontIcon Glyph="&#xE8B7;" FontSize="15" Foreground="#9CA3AF"/>
                                <TextBlock Text="Show Balance" VerticalAlignment="Center" Foreground="#E5E7EB"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="TotalAccountsBtn" Click="TotalAccountsBtn_Click"
                                Style="{StaticResource NavButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <FontIcon Glyph="&#xE80A;" FontSize="15" Foreground="#9CA3AF"/>
                                <TextBlock Text="Total Accounts" VerticalAlignment="Center" Foreground="#E5E7EB"/>
                            </StackPanel>
                        </Button>

                        <Border Height="1" Margin="16,8" Opacity="0.4">
                            <Border.Background>
                                <SolidColorBrush Color="#1E2D4A"/>
                            </Border.Background>
                        </Border>

                        <TextBlock Text="TRANSACTIONS"
                                   FontSize="10" FontWeight="SemiBold"
                                   FontFamily="Segoe UI Variable Text"
                                   Foreground="#6B7280"
                                   CharacterSpacing="120"
                                   Margin="14,20,0,6"/>

                        <Button x:Name="DepositBtn" Click="DepositBtn_Click"
                                Style="{StaticResource NavButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <FontIcon Glyph="&#xE8AB;" FontSize="15" Foreground="#10D986"/>
                                <TextBlock Text="Deposit" VerticalAlignment="Center" Foreground="#E5E7EB"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="WithdrawBtn" Click="WithdrawBtn_Click"
                                Style="{StaticResource NavButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <FontIcon Glyph="&#xE74E;" FontSize="15" Foreground="#F43F5E"/>
                                <TextBlock Text="Withdraw" VerticalAlignment="Center" Foreground="#E5E7EB"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="TransferBtn" Click="TransferBtn_Click"
                                Style="{StaticResource NavButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <FontIcon Glyph="&#xE8AB;" FontSize="15" Foreground="#3B82F6"/>
                                <TextBlock Text="Transfer" VerticalAlignment="Center" Foreground="#E5E7EB"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="HistoryBtn" Click="HistoryBtn_Click"
                                Style="{StaticResource NavButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <FontIcon Glyph="&#xE81C;" FontSize="15" Foreground="#9CA3AF"/>
                                <TextBlock Text="Transactions" VerticalAlignment="Center" Foreground="#E5E7EB"/>
                            </StackPanel>
                        </Button>

                        <Border Height="1" Margin="16,8" Opacity="0.4">
                            <Border.Background>
                                <SolidColorBrush Color="#1E2D4A"/>
                            </Border.Background>
                        </Border>

                        <TextBlock Text="SERVICES"
                                   FontSize="10" FontWeight="SemiBold"
                                   FontFamily="Segoe UI Variable Text"
                                   Foreground="#6B7280"
                                   CharacterSpacing="120"
                                   Margin="14,20,0,6"/>

                        <Button x:Name="ApplyLoanBtn" Click="ApplyLoanBtn_Click"
                                Style="{StaticResource NavButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <FontIcon Glyph="&#xE8A1;" FontSize="15" Foreground="#F59E0B"/>
                                <TextBlock Text="Apply for Loan" VerticalAlignment="Center" Foreground="#E5E7EB"/>
                            </StackPanel>
                        </Button>

                    </StackPanel>

                    <!-- Sign Out -->
                    <Border Padding="8,12" BorderThickness="0,1,0,0"
                            BorderBrush="{StaticResource DividerColor}" Margin="0,16,0,0">
                        <Button x:Name="LogoutBtn" Click="LogoutBtn_Click"
                                Style="{StaticResource DangerNavButtonStyle}"
                                HorizontalAlignment="Stretch">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <FontIcon Glyph="&#xE7E8;" FontSize="15" Foreground="#F43F5E"/>
                                <TextBlock Text="Sign Out" VerticalAlignment="Center"
                                           FontWeight="SemiBold" Foreground="#F43F5E"/>
                            </StackPanel>
                        </Button>
                    </Border>

                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- ════════════════════════════════════════════════════════════
             MAIN CONTENT
             ════════════════════════════════════════════════════════════ -->
        <Grid Grid.Column="1" Background="Transparent">
            <Grid.RowDefinitions>
                <RowDefinition Height="56"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Top bar -->
            <Border Grid.Row="0" Padding="24,0"
                    BorderThickness="0,0,0,1" BorderBrush="#1E2D4A">
                <Border.Background>
                    <SolidColorBrush Color="#0D1120" Opacity="0.6"/>
                </Border.Background>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="6">
                    <TextBlock Text="Dashboard"
                               FontSize="14" FontWeight="SemiBold"
                               FontFamily="Segoe UI Variable Display"
                               Foreground="#F1F5FF"/>
                    <FontIcon Glyph="&#xE76C;" FontSize="10"
                              Foreground="#6B7280" VerticalAlignment="Center"/>
                    <TextBlock x:Name="PageSubtitleText"
                               Text="Overview"
                               FontSize="13"
                               FontFamily="Segoe UI Variable Text"
                               Foreground="#9CA3AF"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- Welcome banner row -->
            <Border Grid.Row="1"
                    x:Name="WelcomeBanner"
                    Margin="28,20,28,0"
                    CornerRadius="14"
                    Padding="24,18"
                    BorderThickness="1">
                <Border.BorderBrush>
                    <SolidColorBrush Color="#1E2D4A"/>
                </Border.BorderBrush>
                <Border.Background>
                    <SolidColorBrush Color="#111C35" Opacity="0.5"/>
                </Border.Background>
                <Grid>
                    <StackPanel>
                        <TextBlock x:Name="BannerGreetingText"
                                   Text="Welcome"
                                   FontSize="18" FontWeight="SemiBold"
                                   FontFamily="Segoe UI Variable Display"
                                   Foreground="#F1F5FF"/>
                        <TextBlock Text="Here is a summary of your financial activity."
                                   FontSize="13"
                                   FontFamily="Segoe UI Variable Text"
                                   Foreground="#9CA3AF"
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                    <Border HorizontalAlignment="Right" VerticalAlignment="Center"
                            Padding="12,6" CornerRadius="8">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#1D4ED8" Offset="0"/>
                                <GradientStop Color="#3B82F6" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <TextBlock Text="Active Account"
                                   FontSize="11.5" FontWeight="SemiBold"
                                   FontFamily="Segoe UI Variable Text"
                                   Foreground="White"/>
                    </Border>
                </Grid>
            </Border>

            <!-- Output area -->
            <ScrollViewer Grid.Row="2" Padding="28,20,28,24">
                <StackPanel Spacing="16">

                    <!-- Result Card — mirrors AdminDashboard's card exactly -->
                    <Border x:Name="ResultCard"
                            CornerRadius="14"
                            Padding="0"
                            BorderThickness="1"
                            MinHeight="320">
                        <Border.BorderBrush>
                            <SolidColorBrush Color="#1E2D4A"/>
                        </Border.BorderBrush>
                        <Border.Background>
                            <SolidColorBrush Color="#0D1525" Opacity="0.5"/>
                        </Border.Background>

                        <StackPanel>
                            <!-- Card header -->
                            <Border Padding="20,16" BorderThickness="0,0,0,1" BorderBrush="#1E2D4A">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Border Width="6" Height="6" CornerRadius="3"
                                            Background="#3B82F6" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="TableTitleText"
                                               Text="OUTPUT"
                                               FontSize="10" FontWeight="SemiBold"
                                               FontFamily="Segoe UI Variable Text"
                                               Foreground="#6B7280"
                                               VerticalAlignment="Center"
                                               CharacterSpacing="120"/>
                                    <Border x:Name="RowCountBadge"
                                            CornerRadius="8" Padding="8,2"
                                            Margin="4,0,0,0"
                                            Visibility="Collapsed">
                                        <Border.Background>
                                            <SolidColorBrush Color="#1E2D4A"/>
                                        </Border.Background>
                                        <TextBlock x:Name="RowCountText"
                                                   FontSize="10"
                                                   FontFamily="Segoe UI Variable Text"
                                                   Foreground="#6B7280"/>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- Plain-text fallback (shown for non-table output) -->
                            <Border x:Name="PlainTextPanel" Padding="24,20">
                                <TextBlock x:Name="ResultText"
                                           TextWrapping="Wrap"
                                           FontFamily="Cascadia Code, Consolas, Courier New"
                                           FontSize="13"
                                           LineHeight="22"
                                           Foreground="#F1F5FF"
                                           IsTextSelectionEnabled="True"
                                           Text="Select an action from the sidebar to get started."/>
                            </Border>

                            <!-- ══ TABLE PANEL ══ -->
                            <Border x:Name="TablePanel" Visibility="Collapsed" Padding="0,0,0,8">
                                <StackPanel>

                                    <!-- Table header row -->
                                    <Border x:Name="TableHeader"
                                            Padding="0,10"
                                            BorderThickness="0,0,0,1"
                                            BorderBrush="#1E2D4A">
                                        <Border.Background>
                                            <SolidColorBrush Color="#060B14"/>
                                        </Border.Background>
                                        <Grid x:Name="HeaderGrid" Margin="20,0"/>
                                    </Border>

                                    <!-- Table body rows -->
                                    <ItemsControl x:Name="TableRows">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <ContentPresenter Content="{Binding}"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                </StackPanel>
                            </Border>

                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>
