<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="ModernUI.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ModernUI"
    xmlns:ani="using:Microsoft.UI.Xaml.Media.Animation">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!-- ══════════════════════════════════════════════════════════
                 WINUI BUTTON BRUSH OVERRIDES — Kill system accent bleed
                 ══════════════════════════════════════════════════════════ -->
            <SolidColorBrush x:Key="ButtonForegroundPointerOver"              Color="White"/>
            <SolidColorBrush x:Key="ButtonForegroundPressed"                  Color="White"/>
            <SolidColorBrush x:Key="ButtonForegroundDisabled"                 Color="White"/>
            <SolidColorBrush x:Key="SystemControlHighlightAltBaseHighBrush"   Color="White"/>
            <SolidColorBrush x:Key="SystemControlHighlightAltMidHighBrush"    Color="White"/>
            <SolidColorBrush x:Key="SystemControlHighlightBaseMediumLowBrush" Color="White"/>
            <SolidColorBrush x:Key="SystemControlHighlightListMediumBrush"    Color="#1E2D4A"/>

            <!-- ══════════════════════════════════════════════════════════
                 DESIGN TOKENS — 2030 Obsidian Glass System
                 ══════════════════════════════════════════════════════════ -->

            <!-- Surface palette -->
            <SolidColorBrush x:Key="AppBg"            Color="#060810" />
            <SolidColorBrush x:Key="SidebarBg"        Color="#080C14" />
            <SolidColorBrush x:Key="CardBg"           Color="#0D1120" />
            <SolidColorBrush x:Key="CardBgElevated"   Color="#121828" />
            <SolidColorBrush x:Key="CardBorder"       Color="#1E2D4A" />
            <SolidColorBrush x:Key="CardBorderGlow"   Color="#2F80ED" />
            <SolidColorBrush x:Key="GlassBg"          Color="#0F1628" />
            <SolidColorBrush x:Key="ContentBg"        Color="#060810" />

            <!-- Accent system -->
            <SolidColorBrush x:Key="AccentBlue"       Color="#3B82F6" />
            <SolidColorBrush x:Key="AccentCyan"       Color="#06B6D4" />
            <SolidColorBrush x:Key="AccentViolet"     Color="#8B5CF6" />
            <SolidColorBrush x:Key="AccentGlow"       Color="#3B82F620" />

            <!-- Text -->
            <SolidColorBrush x:Key="TextPrimary"      Color="#F1F5FF" />
            <SolidColorBrush x:Key="TextSecondary"    Color="#7A8BAA" />
            <SolidColorBrush x:Key="TextMuted"        Color="#3D4F6B" />
            <SolidColorBrush x:Key="TextOnAccent"     Color="#FFFFFF" />

            <!-- Semantic -->
            <SolidColorBrush x:Key="StatusGreen"      Color="#10D986" />
            <SolidColorBrush x:Key="StatusRed"        Color="#F43F5E" />
            <SolidColorBrush x:Key="StatusYellow"     Color="#F59E0B" />
            <SolidColorBrush x:Key="StatusBlue"       Color="#3B82F6" />

            <!-- Dividers -->
            <SolidColorBrush x:Key="DividerColor"     Color="#1A2540" />
            <SolidColorBrush x:Key="DividerLight"     Color="#1E2D4A" />

            <!-- ══════════════════════════════════════════════════════════
                 TEXTBOX — Obsidian Glass, Permanent Glow Border
                 ══════════════════════════════════════════════════════════ -->
            <Style x:Key="StyledTextBox" TargetType="TextBox">
                <Setter Property="FontSize"       Value="14" />
                <Setter Property="FontFamily"     Value="Segoe UI Variable Text" />
                <Setter Property="Foreground"     Value="{StaticResource TextPrimary}" />
                <Setter Property="Background"     Value="Transparent" />
                <Setter Property="Padding"        Value="14,12" />
                <Setter Property="Margin"         Value="0,4,0,0" />
                <Setter Property="MinHeight"      Value="46" />
                <Setter Property="SelectionHighlightColor" Value="{StaticResource AccentBlue}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TextBox">
                            <Grid>
                                <Border x:Name="GlowLayer"
                                        CornerRadius="10"
                                        Opacity="0"
                                        Margin="-2">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#3B82F615" Offset="0"/>
                                            <GradientStop Color="#06B6D410" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>

                                <Border x:Name="BorderElement"
                                        CornerRadius="9"
                                        BorderThickness="1"
                                        BorderBrush="#1E2D4A">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#111827" Offset="0"/>
                                            <GradientStop Color="#0D1420" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>

                                <Border x:Name="TopShimmer"
                                        CornerRadius="9,9,0,0"
                                        Height="1"
                                        VerticalAlignment="Top"
                                        Opacity="0.3">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="Transparent" Offset="0"/>
                                            <GradientStop Color="#5B8DEF"    Offset="0.5"/>
                                            <GradientStop Color="Transparent" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>

                                <ScrollViewer x:Name="ContentElement"
                                              Margin="{TemplateBinding Padding}"
                                              HorizontalScrollBarVisibility="Hidden"
                                              VerticalScrollBarVisibility="Hidden"
                                              HorizontalScrollMode="Auto"
                                              VerticalScrollMode="Disabled"
                                              AutomationProperties.AccessibilityView="Raw" />

                                <TextBlock x:Name="PlaceholderTextContentPresenter"
                                           Foreground="#6B7280"
                                           Margin="{TemplateBinding Padding}"
                                           IsHitTestVisible="False"
                                           Text="{TemplateBinding PlaceholderText}"
                                           TextWrapping="{TemplateBinding TextWrapping}"
                                           VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />

                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualStateGroup.Transitions>
                                            <VisualTransition GeneratedDuration="0:0:0.2">
                                                <VisualTransition.GeneratedEasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </VisualTransition.GeneratedEasingFunction>
                                            </VisualTransition>
                                        </VisualStateGroup.Transitions>
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver">
                                            <Storyboard>
                                                <ColorAnimation Storyboard.TargetName="BorderElement"
                                                                Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)"
                                                                To="#2A3F63" Duration="0:0:0.2"/>
                                                <DoubleAnimation Storyboard.TargetName="TopShimmer"
                                                                 Storyboard.TargetProperty="Opacity"
                                                                 To="0.5" Duration="0:0:0.2"/>
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Focused">
                                            <Storyboard>
                                                <ColorAnimation Storyboard.TargetName="BorderElement"
                                                                Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)"
                                                                To="#3B82F6" Duration="0:0:0.25"/>
                                                <DoubleAnimation Storyboard.TargetName="GlowLayer"
                                                                 Storyboard.TargetProperty="Opacity"
                                                                 To="1" Duration="0:0:0.3"/>
                                                <DoubleAnimation Storyboard.TargetName="TopShimmer"
                                                                 Storyboard.TargetProperty="Opacity"
                                                                 To="1" Duration="0:0:0.3"/>
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Disabled">
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="BorderElement"
                                                                 Storyboard.TargetProperty="Opacity"
                                                                 To="0.35" Duration="0"/>
                                            </Storyboard>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ══════════════════════════════════════════════════════════
                 PASSWORDBOX — Mirror of TextBox glass style
                 ══════════════════════════════════════════════════════════ -->
            <Style x:Key="StyledPasswordBox" TargetType="PasswordBox">
                <Setter Property="FontSize"   Value="14" />
                <Setter Property="FontFamily" Value="Segoe UI Variable Text" />
                <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Padding"    Value="14,12" />
                <Setter Property="Margin"     Value="0,4,0,0" />
                <Setter Property="MinHeight"  Value="46" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="PasswordBox">
                            <Grid>
                                <Border x:Name="GlowLayer"
                                        CornerRadius="10"
                                        Opacity="0"
                                        Margin="-2">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#3B82F615" Offset="0"/>
                                            <GradientStop Color="#06B6D410" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>

                                <Border x:Name="BorderElement"
                                        CornerRadius="9"
                                        BorderThickness="1"
                                        BorderBrush="#1E2D4A">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#111827" Offset="0"/>
                                            <GradientStop Color="#0D1420" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>

                                <Border x:Name="TopShimmer"
                                        CornerRadius="9,9,0,0"
                                        Height="1"
                                        VerticalAlignment="Top"
                                        Opacity="0.3">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="Transparent" Offset="0"/>
                                            <GradientStop Color="#5B8DEF"    Offset="0.5"/>
                                            <GradientStop Color="Transparent" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>

                                <ScrollViewer x:Name="ContentElement"
                                              Margin="{TemplateBinding Padding}"
                                              HorizontalScrollBarVisibility="Hidden"
                                              VerticalScrollBarVisibility="Hidden"
                                              HorizontalScrollMode="Auto"
                                              VerticalScrollMode="Disabled"
                                              AutomationProperties.AccessibilityView="Raw" />

                                <TextBlock x:Name="PlaceholderTextContentPresenter"
                                           Foreground="#6B7280"
                                           Margin="{TemplateBinding Padding}"
                                           IsHitTestVisible="False"
                                           Text="{TemplateBinding PlaceholderText}"
                                           VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />

                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualStateGroup.Transitions>
                                            <VisualTransition GeneratedDuration="0:0:0.2">
                                                <VisualTransition.GeneratedEasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </VisualTransition.GeneratedEasingFunction>
                                            </VisualTransition>
                                        </VisualStateGroup.Transitions>
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver">
                                            <Storyboard>
                                                <ColorAnimation Storyboard.TargetName="BorderElement"
                                                                Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)"
                                                                To="#2A3F63" Duration="0:0:0.2"/>
                                                <DoubleAnimation Storyboard.TargetName="TopShimmer"
                                                                 Storyboard.TargetProperty="Opacity"
                                                                 To="0.5" Duration="0:0:0.2"/>
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Focused">
                                            <Storyboard>
                                                <ColorAnimation Storyboard.TargetName="BorderElement"
                                                                Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)"
                                                                To="#3B82F6" Duration="0:0:0.25"/>
                                                <DoubleAnimation Storyboard.TargetName="GlowLayer"
                                                                 Storyboard.TargetProperty="Opacity"
                                                                 To="1" Duration="0:0:0.3"/>
                                                <DoubleAnimation Storyboard.TargetName="TopShimmer"
                                                                 Storyboard.TargetProperty="Opacity"
                                                                 To="1" Duration="0:0:0.3"/>
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Disabled">
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="BorderElement"
                                                                 Storyboard.TargetProperty="Opacity"
                                                                 To="0.35" Duration="0"/>
                                            </Storyboard>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ══════════════════════════════════════════════════════════
                 COMBOBOX — Glass dropdown with animated arrow
                 ══════════════════════════════════════════════════════════ -->
            <Style x:Key="StyledComboBox" TargetType="ComboBox">
                <Setter Property="FontSize"   Value="14" />
                <Setter Property="FontFamily" Value="Segoe UI Variable Text" />
                <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Padding"    Value="14,10" />
                <Setter Property="Margin"     Value="0,4,0,0" />
                <Setter Property="MinHeight"  Value="46" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ComboBox">
                            <Grid>
                                <Border x:Name="GlowLayer"
                                        CornerRadius="10"
                                        Opacity="0"
                                        Margin="-2">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#3B82F615" Offset="0"/>
                                            <GradientStop Color="#06B6D410" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>

                                <Border x:Name="BorderElement"
                                        CornerRadius="9"
                                        BorderThickness="1"
                                        BorderBrush="#1E2D4A">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#111827" Offset="0"/>
                                            <GradientStop Color="#0D1420" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>

                                <Border x:Name="TopShimmer"
                                        CornerRadius="9,9,0,0"
                                        Height="1"
                                        VerticalAlignment="Top"
                                        Opacity="0.3">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="Transparent" Offset="0"/>
                                            <GradientStop Color="#5B8DEF"    Offset="0.5"/>
                                            <GradientStop Color="Transparent" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>

                                <ContentPresenter x:Name="ContentPresenter"
                                                  Margin="{TemplateBinding Padding}"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="Center"
                                                  Content="{TemplateBinding SelectionBoxItem}"
                                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                  Foreground="{StaticResource TextPrimary}" />

                                <Border HorizontalAlignment="Right" Width="44" CornerRadius="0,9,9,0">
                                    <FontIcon x:Name="ChevronIcon"
                                              Glyph="&#xE70D;"
                                              FontSize="10"
                                              Foreground="#3B82F6"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center">
                                        <FontIcon.RenderTransform>
                                            <RotateTransform x:Name="ChevronRotate" CenterX="5" CenterY="5"/>
                                        </FontIcon.RenderTransform>
                                    </FontIcon>
                                </Border>

                                <Popup x:Name="Popup">
                                    <Border Background="#0D1120"
                                            BorderBrush="#1E2D4A"
                                            BorderThickness="1"
                                            CornerRadius="10"
                                            Padding="4"
                                            Margin="0,4,0,0">
                                        <Border.Shadow>
                                            <ThemeShadow/>
                                        </Border.Shadow>
                                        <ScrollViewer x:Name="ScrollViewer"
                                                      AutomationProperties.AccessibilityView="Raw"
                                                      MaxHeight="200">
                                            <ItemsPresenter x:Name="ItemsPresenter" />
                                        </ScrollViewer>
                                    </Border>
                                </Popup>

                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualStateGroup.Transitions>
                                            <VisualTransition GeneratedDuration="0:0:0.2">
                                                <VisualTransition.GeneratedEasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </VisualTransition.GeneratedEasingFunction>
                                            </VisualTransition>
                                        </VisualStateGroup.Transitions>
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver">
                                            <Storyboard>
                                                <ColorAnimation Storyboard.TargetName="BorderElement"
                                                                Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)"
                                                                To="#2A3F63" Duration="0:0:0.2"/>
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <Storyboard>
                                                <ColorAnimation Storyboard.TargetName="BorderElement"
                                                                Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)"
                                                                To="#3B82F6" Duration="0:0:0.15"/>
                                                <DoubleAnimation Storyboard.TargetName="GlowLayer"
                                                                 Storyboard.TargetProperty="Opacity"
                                                                 To="1" Duration="0:0:0.2"/>
                                                <DoubleAnimation Storyboard.TargetName="ChevronRotate"
                                                                 Storyboard.TargetProperty="Angle"
                                                                 To="180" Duration="0:0:0.25">
                                                    <DoubleAnimation.EasingFunction>
                                                        <BackEase EasingMode="EaseOut" Amplitude="0.3"/>
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Focused">
                                            <Storyboard>
                                                <ColorAnimation Storyboard.TargetName="BorderElement"
                                                                Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)"
                                                                To="#3B82F6" Duration="0:0:0.25"/>
                                                <DoubleAnimation Storyboard.TargetName="GlowLayer"
                                                                 Storyboard.TargetProperty="Opacity"
                                                                 To="1" Duration="0:0:0.3"/>
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Disabled">
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="BorderElement"
                                                                 Storyboard.TargetProperty="Opacity"
                                                                 To="0.35" Duration="0"/>
                                            </Storyboard>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ComboBoxItem — Obsidian hover glow -->
            <Style TargetType="ComboBoxItem">
                <Setter Property="Background"                 Value="Transparent" />
                <Setter Property="Foreground"                 Value="{StaticResource TextPrimary}" />
                <Setter Property="FontSize"                   Value="14" />
                <Setter Property="FontFamily"                 Value="Segoe UI Variable Text" />
                <Setter Property="Padding"                    Value="12,9" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="CornerRadius"               Value="7" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ComboBoxItem">
                            <Border x:Name="Root"
                                    Background="{TemplateBinding Background}"
                                    Padding="{TemplateBinding Padding}"
                                    CornerRadius="7"
                                    Margin="0,1">
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="Center"
                                                  Foreground="{StaticResource TextPrimary}" />
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualStateGroup.Transitions>
                                            <VisualTransition GeneratedDuration="0:0:0.12">
                                                <VisualTransition.GeneratedEasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </VisualTransition.GeneratedEasingFunction>
                                            </VisualTransition>
                                        </VisualStateGroup.Transitions>
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver">
                                            <Storyboard>
                                                <ColorAnimation Storyboard.TargetName="Root"
                                                                Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                                To="#1A2540" Duration="0:0:0.12"/>
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Selected">
                                            <Storyboard>
                                                <ColorAnimation Storyboard.TargetName="Root"
                                                                Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                                To="#1C3A6E" Duration="0:0:0.15"/>
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Disabled" />
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <!-- ══════════════════════════════════════════════════════════
     PREMIUM BUTTON — NO YELLOWING (Pure Solid Colors)
     ══════════════════════════════════════════════════════════ -->
            <Style x:Key="PremiumButtonStyle" TargetType="Button">
                <Setter Property="Background"          Value="#3B82F6" />
                <Setter Property="Foreground"          Value="White" />
                <Setter Property="BorderThickness"     Value="0" />
                <Setter Property="CornerRadius"        Value="9" />
                <Setter Property="FontSize"            Value="14" />
                <Setter Property="FontFamily"          Value="Segoe UI Variable Text" />
                <Setter Property="FontWeight"          Value="SemiBold" />
                <Setter Property="Height"              Value="48" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <!-- Root Grid with Center Origin for Scaling -->
                            <Grid x:Name="RootGrid" RenderTransformOrigin="0.5,0.5">
                                <Grid.RenderTransform>
                                    <ScaleTransform x:Name="ButtonScale" ScaleX="1" ScaleY="1"/>
                                </Grid.RenderTransform>

                                <!-- 1. Main Background Gradient (Solid Colors) -->
                                <Border x:Name="BackgroundBorder" CornerRadius="9">
                                    <Border.Background>
                                        <LinearGradientBrush x:Name="BtnGradient" StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop x:Name="GradStop1" Color="#3B82F6" Offset="0"/>
                                            <GradientStop x:Name="GradStop2" Color="#2563EB" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>

                                <!-- 2. Glass Edge Highlight (Top Only - Safe) -->
                                <Border CornerRadius="9,9,0,0" Height="1" VerticalAlignment="Top" Opacity="0.5">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="Transparent" Offset="0"/>
                                            <GradientStop Color="#FFFFFF"  Offset="0.5"/>
                                            <GradientStop Color="Transparent" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>

                                <!-- 3. Content -->
                                <ContentPresenter x:Name="ContentPresenter"
                                      Content="{TemplateBinding Content}"
                                      HorizontalContentAlignment="Center"
                                      VerticalContentAlignment="Center"
                                      Foreground="White"
                                      IsTabStop="False"/>

                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">

                                        <!-- ═══════════ NORMAL ═══════════ -->
                                        <VisualState x:Name="Normal">
                                            <Storyboard>
                                                <!-- Smooth return to scale 1 -->
                                                <DoubleAnimation Storyboard.TargetName="ButtonScale"
                                                     Storyboard.TargetProperty="ScaleX"
                                                     To="1" Duration="0:0:0.3">
                                                    <DoubleAnimation.EasingFunction>
                                                        <CubicEase EasingMode="EaseOut"/>
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                                <DoubleAnimation Storyboard.TargetName="ButtonScale"
                                                     Storyboard.TargetProperty="ScaleY"
                                                     To="1" Duration="0:0:0.3">
                                                    <DoubleAnimation.EasingFunction>
                                                        <CubicEase EasingMode="EaseOut"/>
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>

                                                <!-- Reset to Standard Blue -->
                                                <ColorAnimation Storyboard.TargetName="GradStop1" Storyboard.TargetProperty="Color" To="#3B82F6" Duration="0:0:0.3"/>
                                                <ColorAnimation Storyboard.TargetName="GradStop2" Storyboard.TargetProperty="Color" To="#2563EB" Duration="0:0:0.3"/>
                                            </Storyboard>
                                        </VisualState>

                                        <!-- ═══════════ HOVER (Lift + Brighter) ═══════════ -->
                                        <VisualState x:Name="PointerOver">
                                            <Storyboard>
                                                <!-- Lift Up (Professional Tactile Feel) -->
                                                <DoubleAnimation Storyboard.TargetName="ButtonScale"
                                                     Storyboard.TargetProperty="ScaleX"
                                                     To="1.02" Duration="0:0:0.2">
                                                    <DoubleAnimation.EasingFunction>
                                                        <CubicEase EasingMode="EaseOut"/>
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                                <DoubleAnimation Storyboard.TargetName="ButtonScale"
                                                     Storyboard.TargetProperty="ScaleY"
                                                     To="1.02" Duration="0:0:0.2">
                                                    <DoubleAnimation.EasingFunction>
                                                        <CubicEase EasingMode="EaseOut"/>
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>

                                                <!-- Shift to Lighter Blue (No mixing) -->
                                                <ColorAnimation Storyboard.TargetName="GradStop1" Storyboard.TargetProperty="Color" To="#60A5FA" Duration="0:0:0.2"/>
                                                <ColorAnimation Storyboard.TargetName="GradStop2" Storyboard.TargetProperty="Color" To="#3B82F6" Duration="0:0:0.2"/>
                                            </Storyboard>
                                        </VisualState>

                                        <!-- ═══════════ PRESSED (Push Down) ═══════════ -->
                                        <VisualState x:Name="Pressed">
                                            <Storyboard>
                                                <!-- Push Down -->
                                                <DoubleAnimation Storyboard.TargetName="ButtonScale"
                                                     Storyboard.TargetProperty="ScaleX"
                                                     To="0.97" Duration="0:0:0.05"/>
                                                <DoubleAnimation Storyboard.TargetName="ButtonScale"
                                                     Storyboard.TargetProperty="ScaleY"
                                                     To="0.97" Duration="0:0:0.05"/>

                                                <!-- Shift to Darker Blue -->
                                                <ColorAnimation Storyboard.TargetName="GradStop1" Storyboard.TargetProperty="Color" To="#1D4ED8" Duration="0:0:0.05"/>
                                                <ColorAnimation Storyboard.TargetName="GradStop2" Storyboard.TargetProperty="Color" To="#1E40AF" Duration="0:0:0.05"/>
                                            </Storyboard>
                                        </VisualState>

                                        <VisualState x:Name="Disabled">
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="ContentPresenter" Storyboard.TargetProperty="Opacity" To="0.4" Duration="0"/>
                                                <DoubleAnimation Storyboard.TargetName="BackgroundBorder" Storyboard.TargetProperty="Opacity" To="0.5" Duration="0"/>
                                            </Storyboard>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ══════════════════════════════════════════════════════════
                 NAV BUTTON — Sidebar navigation with active bar + glow
                 ══════════════════════════════════════════════════════════ -->
            <Style x:Key="NavButtonStyle" TargetType="Button">
                <Setter Property="Background"                 Value="Transparent" />
                <Setter Property="Foreground"                 Value="{StaticResource TextSecondary}" />
                <Setter Property="BorderThickness"            Value="0" />
                <Setter Property="HorizontalAlignment"        Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Left" />
                <Setter Property="Padding"                    Value="14,10" />
                <Setter Property="CornerRadius"               Value="8" />
                <Setter Property="FontSize"                   Value="13.5" />
                <Setter Property="FontFamily"                 Value="Segoe UI Variable Text" />
                <Setter Property="FontWeight"                 Value="Normal" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid x:Name="RootGrid" CornerRadius="8">
                                <Grid.RenderTransform>
                                    <TranslateTransform x:Name="SlideX"/>
                                </Grid.RenderTransform>

                                <Border x:Name="HoverBg" CornerRadius="8">
                                    <Border.Background>
                                        <SolidColorBrush x:Name="HoverBgBrush" Color="Transparent"/>
                                    </Border.Background>
                                </Border>

                                <Border x:Name="ActiveBar"
                                        Width="3"
                                        HorizontalAlignment="Left"
                                        CornerRadius="0,2,2,0"
                                        Opacity="0">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#3B82F6" Offset="0"/>
                                            <GradientStop Color="#06B6D4" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>

                                <Border x:Name="ContentWrapper"
                                        Opacity="0.7"
                                        Padding="{TemplateBinding Padding}">
                                    <Border.RenderTransform>
                                        <TranslateTransform x:Name="ContentSlide"/>
                                    </Border.RenderTransform>
                                    <ContentPresenter HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                      VerticalContentAlignment="Center"
                                                      Foreground="{TemplateBinding Foreground}" />
                                </Border>

                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal">
                                            <Storyboard>
                                                <ColorAnimation Storyboard.TargetName="HoverBgBrush"
                                                                Storyboard.TargetProperty="Color"
                                                                To="Transparent" Duration="0:0:0.2"/>
                                                <DoubleAnimation Storyboard.TargetName="ContentWrapper"
                                                                 Storyboard.TargetProperty="Opacity"
                                                                 To="0.7" Duration="0:0:0.2"/>
                                                <DoubleAnimation Storyboard.TargetName="ActiveBar"
                                                                 Storyboard.TargetProperty="Opacity"
                                                                 To="0" Duration="0:0:0.15"/>
                                                <DoubleAnimation Storyboard.TargetName="ContentSlide"
                                                                 Storyboard.TargetProperty="X"
                                                                 To="0" Duration="0:0:0.2">
                                                    <DoubleAnimation.EasingFunction>
                                                        <CubicEase EasingMode="EaseOut"/>
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="PointerOver">
                                            <Storyboard>
                                                <ColorAnimation Storyboard.TargetName="HoverBgBrush"
                                                                Storyboard.TargetProperty="Color"
                                                                To="#0F1628" Duration="0:0:0.15"/>
                                                <DoubleAnimation Storyboard.TargetName="ContentWrapper"
                                                                 Storyboard.TargetProperty="Opacity"
                                                                 To="1" Duration="0:0:0.15"/>
                                                <DoubleAnimation Storyboard.TargetName="ActiveBar"
                                                                 Storyboard.TargetProperty="Opacity"
                                                                 To="0.5" Duration="0:0:0.15"/>
                                                <DoubleAnimation Storyboard.TargetName="ContentSlide"
                                                                 Storyboard.TargetProperty="X"
                                                                 To="3" Duration="0:0:0.2">
                                                    <DoubleAnimation.EasingFunction>
                                                        <BackEase EasingMode="EaseOut" Amplitude="0.3"/>
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <Storyboard>
                                                <ColorAnimation Storyboard.TargetName="HoverBgBrush"
                                                                Storyboard.TargetProperty="Color"
                                                                To="#141E35" Duration="0:0:0.06"/>
                                                <DoubleAnimation Storyboard.TargetName="ContentWrapper"
                                                                 Storyboard.TargetProperty="Opacity"
                                                                 To="1" Duration="0:0:0.06"/>
                                                <DoubleAnimation Storyboard.TargetName="ActiveBar"
                                                                 Storyboard.TargetProperty="Opacity"
                                                                 To="1" Duration="0:0:0.08"/>
                                                <DoubleAnimation Storyboard.TargetName="ContentSlide"
                                                                 Storyboard.TargetProperty="X"
                                                                 To="1" Duration="0:0:0.06"/>
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Disabled">
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="ContentWrapper"
                                                                 Storyboard.TargetProperty="Opacity"
                                                                 To="0.25" Duration="0:0:0.1"/>
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Focused" />
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="DangerNavButtonStyle" TargetType="Button" BasedOn="{StaticResource NavButtonStyle}">
                <Setter Property="Foreground" Value="{StaticResource StatusRed}" />
            </Style>

            <!-- ══════════════════════════════════════════════════════════
                 ACTION BUTTON — Ghost style with hover fill
                 ══════════════════════════════════════════════════════════ -->
            <Style x:Key="ActionButtonStyle" TargetType="Button">
                <Setter Property="Background"      Value="Transparent" />
                <Setter Property="Foreground"      Value="{StaticResource TextPrimary}" />
                <Setter Property="BorderBrush"     Value="#1E2D4A" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius"    Value="8" />
                <Setter Property="FontSize"        Value="13" />
                <Setter Property="FontFamily"      Value="Segoe UI Variable Text" />
                <Setter Property="FontWeight"      Value="SemiBold" />
                <Setter Property="Padding"         Value="16,9" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Root"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="{TemplateBinding CornerRadius}"
                                    Padding="{TemplateBinding Padding}">
                                <Border.RenderTransform>
                                    <ScaleTransform x:Name="ActionScale" ScaleX="1" ScaleY="1"/>
                                </Border.RenderTransform>
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  Foreground="{TemplateBinding Foreground}" />
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualStateGroup.Transitions>
                                            <VisualTransition GeneratedDuration="0:0:0.15">
                                                <VisualTransition.GeneratedEasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </VisualTransition.GeneratedEasingFunction>
                                            </VisualTransition>
                                        </VisualStateGroup.Transitions>
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver">
                                            <Storyboard>
                                                <ColorAnimation Storyboard.TargetName="Root"
                                                                Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                                To="#0F1628" Duration="0:0:0.15"/>
                                                <ColorAnimation Storyboard.TargetName="Root"
                                                                Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)"
                                                                To="#2A3F63" Duration="0:0:0.15"/>
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <Storyboard>
                                                <ColorAnimation Storyboard.TargetName="Root"
                                                                Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                                To="#141E35" Duration="0:0:0.06"/>
                                                <DoubleAnimation Storyboard.TargetName="ActionScale"
                                                                 Storyboard.TargetProperty="ScaleX"
                                                                 To="0.97" Duration="0:0:0.06"/>
                                                <DoubleAnimation Storyboard.TargetName="ActionScale"
                                                                 Storyboard.TargetProperty="ScaleY"
                                                                 To="0.97" Duration="0:0:0.06"/>
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Disabled">
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="Root"
                                                                 Storyboard.TargetProperty="Opacity"
                                                                 To="0.4" Duration="0"/>
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Focused" />
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="SearchActionButtonStyle" TargetType="Button" BasedOn="{StaticResource ActionButtonStyle}">
                <Setter Property="Background"  Value="#3B82F6" />
                <Setter Property="Foreground"  Value="White" />
                <Setter Property="BorderBrush" Value="#3B82F6" />
            </Style>

            <!-- ══════════════════════════════════════════════════════════
                 TYPOGRAPHY STYLES
                 ══════════════════════════════════════════════════════════ -->
            <Style x:Key="SectionLabel" TargetType="TextBlock">
                <Setter Property="Foreground"       Value="{StaticResource TextMuted}" />
                <Setter Property="FontSize"         Value="10" />
                <Setter Property="FontFamily"       Value="Segoe UI Variable Text" />
                <Setter Property="FontWeight"       Value="SemiBold" />
                <Setter Property="CharacterSpacing" Value="120" />
                <Setter Property="Margin"           Value="14,20,0,6" />
            </Style>

            <Style x:Key="SectionDivider" TargetType="Border">
                <Setter Property="Height"     Value="1" />
                <Setter Property="Margin"     Value="16,8" />
                <Setter Property="Background" Value="{StaticResource DividerLight}" />
                <Setter Property="Opacity"    Value="0.4" />
            </Style>

            <Style x:Key="StyledHyperlink" TargetType="HyperlinkButton">
                <Setter Property="Foreground"      Value="{StaticResource AccentBlue}" />
                <Setter Property="FontSize"        Value="13" />
                <Setter Property="FontFamily"      Value="Segoe UI Variable Text" />
                <Setter Property="FontWeight"      Value="SemiBold" />
                <Setter Property="Padding"         Value="0" />
                <Setter Property="Background"      Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
            </Style>

        </ResourceDictionary>
    </Application.Resources>
</Application>